KEJI_DATA_DIR=./data
KEJI_FFMPEG_PATH=ffmpeg

KEJI_SENSEVOICE_ENABLED=false
KEJI_SENSEVOICE_PYTHON=/opt/keji/venvs/sensevoice/bin/python
KEJI_SENSEVOICE_MODEL=/opt/keji/models/SenseVoiceSmall
KEJI_SENSEVOICE_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
KEJI_SENSEVOICE_THREADS=6
KEJI_SENSEVOICE_WORKERS=2
KEJI_SENSEVOICE_TIMEOUT_SECONDS=90
KEJI_SENSEVOICE_CHUNK_SECONDS=30
KEJI_SENSEVOICE_CHUNK_OVERLAP_SECONDS=2

KEJI_OCR_MODEL=PP-OCRv6_medium
KEJI_OCR_CPU_THREADS=2
KEJI_OCR_ENABLE_HPI=true

KEJI_LLM_BASE_URL=https://api.example.com/v1
KEJI_LLM_API_KEY=
KEJI_LLM_MODEL=
KEJI_LLM_TIMEOUT_SECONDS=180

KEJI_CORRECTION_LLM_ENABLED=false
KEJI_CORRECTION_LLM_BASE_URL=http://127.0.0.1:8081/v1
KEJI_CORRECTION_LLM_API_KEY=local
KEJI_CORRECTION_LLM_MODEL=qwen3-1.7b
KEJI_CORRECTION_LLM_TIMEOUT_SECONDS=30

# 可选：App 自更新信息
KEJI_UPDATE_APK_VERSION=
KEJI_UPDATE_APK_NAME=app-debug.apk
KEJI_UPDATE_APK_NOTES=

# 仅测试脚本使用，不参与服务端启动
KEJI_USERNAME=
KEJI_PASSWORD=
